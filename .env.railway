APP_NAME="Syscend Campus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.up.railway.app
APP_TIMEZONE=Africa/Freetown

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=${{PostgreSQL.DATABASE_HOST}}
DB_PORT=5432
DB_DATABASE=${{PostgreSQL.DATABASE}}
DB_USERNAME=${{PostgreSQL.DATABASE_USER}}
DB_PASSWORD=${{PostgreSQL.DATABASE_PASSWORD}}
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@syscend.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEY=

SMS_PROVIDER=vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SENDER_ID=Syscend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_USER=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_RETURN_URL="${APP_URL}/school/fees/payments/callback?method=orange_money"
ORANGE_MONEY_CANCEL_URL="${APP_URL}/school/fees/payments/callback?method=orange_money&status=cancelled"
ORANGE_MONEY_WEBHOOK_URL="${APP_URL}/api/v1/payments/webhook/orange-money"

ORANGE_MONEY_PLATFORM_MERCHANT_KEY=
ORANGE_MONEY_PLATFORM_API_USER=
ORANGE_MONEY_PLATFORM_API_KEY=

AFRIMONEY_API_KEY=
AFRIMONEY_APP_ID=
AFRIMONEY_APP_SECRET=
